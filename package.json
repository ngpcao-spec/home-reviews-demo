{
  "name": "home-reviews",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-pwa.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.resume.config.ts",
    "test:pwa:offline": "vite build --config tests/e2e/vite.shell.config.ts && node scripts/prepare-pwa-test.mjs && playwright test --config playwright.shell.config.ts",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "supabase": "^2.118.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
